<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The data model: entities, EF Core mapping and migrations. A library rather than part of the
    API so the seed generator and the eval tool can use it without pulling in ASP.NET Core.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microting.EntityFrameworkCore.MySql" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The demo knowledge base and call transcripts, as readable markdown in the repo. -->
    <EmbeddedResource Include="Seed\Documents\*.md" LogicalName="documents/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Seed\Calls\*.md" LogicalName="calls/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Truckroll.Api.Tests" />
  </ItemGroup>

</Project>
