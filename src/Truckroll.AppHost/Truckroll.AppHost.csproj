<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Aspire AppHost: one `aspire run` (or `dotnet run` on this project) starts MySQL, Redis,
    the API and the Next.js app, wires their connection strings together, and opens the
    dashboard with logs, traces and metrics for all of them.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>truckroll-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.Dotnet" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.Kafka" />
    <PackageReference Include="Aspire.Hosting.MySql" />
    <PackageReference Include="Aspire.Hosting.Redis" />
  </ItemGroup>

</Project>
